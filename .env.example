# Chave da API Anthropic (obrigatório)
# Encontre em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Chave da API do Omni — gerada automaticamente no primeiro boot do container omni
# Passo: docker compose up omni → copie a chave do log → cole aqui → docker compose up genie
OMNI_API_KEY=

# Senha do banco de dados do agente (Postgres)
# Use uma senha forte em produção
AGENT_DB_PASSWORD=agent
