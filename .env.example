# Chave da API Anthropic (somente se usar GENIE_EXECUTOR=sdk)
ANTHROPIC_API_KEY=

# Chave da API do Omni — gerada automaticamente no primeiro boot
# docker compose up omni → copie do log → cole aqui → docker compose up genie
OMNI_API_KEY=

# Senhas dos bancos de dados (valores padrão funcionam para desenvolvimento)
AGENT_DB_PASSWORD=agent
OMNI_DB_PASSWORD=omni

# Endpoint local do Omni / Genie (modo nativo sem Docker)
OMNI_API_URL=http://localhost:8882
GENIE_NATS_URL=localhost:4222
